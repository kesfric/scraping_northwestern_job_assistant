# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP (free, sends to any recipient, no domain needed).
# GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is a 16-character
# app password generated at myaccount.google.com/apppasswords (requires
# 2-Step Verification to be turned on for the account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Job Alerts <your-gmail-address@gmail.com>

# Where this project is deployed (used to build confirm/unsubscribe links
# in emails). No trailing slash.
SITE_URL=http://localhost:3000

# The Power BI report to scrape. Defaults to the Northwestern Student Job
# Board if unset.
POWERBI_REPORT_URL=https://app.powerbi.com/view?r=eyJrIjoiMmUwNDhmNjEtMGRhMS00OTlhLWE1NjQtM2VkZjFlYTg3MzNhIiwidCI6IjdkNzZkMzYxLTgyNzctNDcwOC1hNDc3LTY0ZTgzNjZjZDFiYyIsImMiOjN9&pageName=ReportSection
